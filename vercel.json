{
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/privacy_policy", "destination": "/privacy_policy.html" },
    { "source": "/security", "destination": "/security_confidentiality.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
